# Existing Git repositories under this root can be selected in the dashboard.
DON_WORKSPACE_ROOT=./workspaces
DON_DATABASE=./data/don-codino.sqlite3
DON_TIMEOUT_SECONDS=600
# Optional: absolute path to codex.exe (Windows) or codex (macOS/Linux).
DON_CODEX_BINARY=codex
# Build locally with: docker build -t don-codino-verifier:local verification
DON_VERIFIER_IMAGE=don-codino-verifier:local
# Optional AI refinement. Without both values, template mode is used honestly.
OPENAI_API_KEY=
DON_OPENAI_MODEL=
# Maximum simultaneous local contracts (1–4); overflow is rejected, not silently queued.
DON_MAX_ACTIVE_TASKS=2
